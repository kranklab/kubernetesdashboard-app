{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Kubernetes Dashboard",
  "id": "kranklab-kubernetes-dashboard-app",
  "backend": true,
  "executable": "gpx_kubernetes_dashboard",
  "info": {
    "keywords": ["app", "kubernetes", "k8s", "dashboard", "cluster"],
    "description": "Browse, search, and inspect Kubernetes resources from Grafana. Card-based views for workloads, networking, config & storage, cluster resources, and CRDs, with drilldown detail panels including YAML, live pod logs, and events.",
    "author": {
      "name": "Kranklab"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [
      {
        "name": "Cluster overview",
        "path": "img/overview.png"
      },
      {
        "name": "Deployments",
        "path": "img/deployments.png"
      },
      {
        "name": "Configs and storage",
        "path": "img/configs-and-storage.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Home",
      "path": "/a/%PLUGIN_ID%/home",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "Workloads",
      "path": "/a/%PLUGIN_ID%/workloads",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Networking",
      "path": "/a/%PLUGIN_ID%/networking",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Config & Storage",
      "path": "/a/%PLUGIN_ID%/config-storage",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Cluster",
      "path": "/a/%PLUGIN_ID%/cluster",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Custom Resource Definitions",
      "path": "/a/%PLUGIN_ID%/crds",
      "addToNav": true,
      "defaultNav": false
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.4.0",
    "plugins": []
  }
}
